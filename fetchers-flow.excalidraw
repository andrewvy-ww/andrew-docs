      "isDeleted": false,
      "boundElements": [],
      "updated": 1789157553697,
      "link": null,
      "locked": false,
      "text": "Sale that gets the session's params\n    joins each sale to session on tracking_id = unique_id\n    (L129-L134), except Amazon, where the sale carries \n    a rotating amz_tag rather than a session id, so a time-windowed\ntag → unique_id map built from pageviews is used instead",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sale that gets the session's params\n    joins each sale to session on tracking_id = unique_id\n    (L129-L134), except Amazon, where the sale carries \n    a rotating amz_tag rather than a session id, so a time-windowed\ntag → unique_id map built from pageviews is used instead",
      "autoResize": true,
      "lineHeight": 1.25
    },
