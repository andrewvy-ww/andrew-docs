    {
      "id": "bbae9d0401a74eb6a574d4fcf15b3de5",
      "type": "text",
      "x": 1618,
      "y": 4300.3,
      "width": 1414,
      "height": 44.2,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
