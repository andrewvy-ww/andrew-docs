      "version": 1,
      "versionNonce": 266,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794326400000,
      "link": null,
      "locked": false,
      "text": "Eligible $100 brand-owned sale -> $10 performance fee + $7 usage. Real partnership: creator payable under normal split. Brand-owned ad: $10 retained by\nWayward. Affiliate network commission remains separate.",
      "originalText": "Eligible $100 brand-owned sale -> $10 performance fee + $7 usage. Real partnership: creator payable under normal split. Brand-owned ad: $10 retained by\nWayward. Affiliate network commission remains separate.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3
    },
    {
      "id": "2b5b50e7d8774d939b3e2acbd9a0bc32",
      "type": "text",
      "x": 60,
      "y": 4490,
      "width": 2990,
      "height": 28.6,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 267,
      "version": 1,
      "versionNonce": 267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794326400000,
      "link": null,
      "locked": false,
      "text": "Unaffected operational paths: Meta identity, creator approval, comment replies, promo consent, creator logos / voice, discovery and creative access. Their Postgres partnership field remains unchanged.",
      "originalText": "Unaffected operational paths: Meta identity, creator approval, comment replies, promo consent, creator logos / voice, discovery and creative access. Their Postgres partnership field remains unchanged.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3
    },
    {
      "id": "8e3c232eccc64415bcfb136e83a0684b",
      "type": "text",
      "x": 60,
      "y": 4570,
      "width": 2990,
      "height": 57.2,
      "angle": 0,
      "strokeColor": "#9a3412",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 268,
      "version": 1,
      "versionNonce": 268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794326400000,
      "link": null,
      "locked": false,
      "text": "Important: removing the null-creator rate guard alone is insufficient. The accrual writer currently drops null-creator commission lines, and payout contracts treat partnership commission as creator money. Pricing + line classification + settlement +\nAPI reads must change together.",
      "originalText": "Important: removing the null-creator rate guard alone is insufficient. The accrual writer currently drops null-creator commission lines, and payout contracts treat partnership commission as creator money. Pricing + line classification + settlement +\nAPI reads must change together.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3
