lementId":"-FVsOuTULAoAcq0QyVBTu","mode":"orbit","fixedPoint":[0.5001,0]},"endBinding":{"elementId":"V4o7HjPqsuWShcrDdM-TK","mode":"orbit","fixedPoint":[0.5001,1]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"moveMidPointsWithElement":false},{"id":"LJdWJYK8jrBVmJcib5M_W","type":"text","x":-101.34524239532323,"y":739.5123868382743,"width":491.599609375,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aJ","roundness":null,"seed":1671464102,"version":152,"versionNonce":888742886,"isDeleted":false,"boundElements":[],"updated":1776972748857,"link":null,"locked":false,"text":"- headline and social copy derived from social post","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"- headline and social copy derived from social post","autoResize":true,"lineHeight":1.25},{"id":"mw8LiTVwtnK1cAfEkH1Xs","type":"arrow","x":256.02115559378035,"y":664.9185787866819,"width":252.2249550765302,"height":14.874790678043496,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aK","roundness":{"type":2},"seed":499465574,"version":201,"versionNonce":697958138,"isDeleted":false,"boundElements":[],"updated":1776979478428,"link":null,"locked":false,"points":[[0,0],[252.2249550765302,14.874790678043496]],"startBinding":{"elementId":"-FVsOuTULAoAcq0QyVBTu","mode":"orbit","fixedPoint":[1,0.5001]},"endBinding":{"elementId":"37L5HcdJmEkKcco1suuFu","mode":"orbit","fixedPoint":[0.7126481935351472,0.7126481935351472]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"moveMidPointsWithElement":false},{"id":"1RL-KK8pVbOJb3um-Bh36","type":"text","x":162.43651033983326,"y":834.1212394098815,"width":1046.359375,"height":350,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aL","roundness":null,"seed":1547481594,"version":845,"versionNonce":2138926650,"isDeleted":false,"boundElements":[],"updated":1776977251509,"link":null,"locked":false,"text":"Current State\n\nRight now we populate abstract_brand_id of a social post through the following\n1. Extract links from social_post caption\n2. get brand names from omni external API\n3. Query wayward connect for abstract brand id\n\nThis provides the connection for a creator's social post -> brand's Wayward account so they can view it.\n\nCurrent Assumptions: \n1. Brand with product urls in social posts. exist on Wayward Connect (may not be the case)\n2. User will not change fb page / insta account on Wayward account (though technically allowed right now)\n3. Many assets can come from one post\n4. A post can be associated with many brands","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Current State\n\nRight now we populate abstract_brand_id of a social post through the following\n1. Extract links from social_post caption\n2. get brand names from omni external API\n3. Query wayward connect for abstract brand id\n\nThis provides the connection for a creator's social post -> brand's Wayward account so they can view it.\n\nCurrent Assumptions: \n1. Brand with product urls in social posts. exist on Wayward Connect (may not be the case)\n2. User will not change fb page / insta account on Wayward account (though technically allowed right now)\n3. Many assets can come from one post\n4. A post can be associated with many brands","autoResize":true,"lineHeight":1.25},{"id":"6Bs7c_MnRlx5HQtmoLMmd","type":"text","x":116.38284321150206,"y":1260.1592210696635,"width":835.3194580078125,"height":200,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aM","roundness":null,"seed":1230678374,"version":602,"versionNonce":2112841510,"isDeleted":false,"boundElements":[],"updated":1776976731894,"link":null,"locked":false,"text":"Problem\nWe want to match through Product URL or facebook/insta mention of brand account\n\nCases\n  a. Brand not on Wayward Boost yet when post is imported\n  b. Brand not be in Wayward Connect yet when post is imported\n  c. Brand does not exist on either\n  d. Happy Path: brand exists on boost + connect","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Problem\nWe want to match through Product URL or facebook/insta mention of brand account\n\nCases\n  a. Brand not on Wayward Boost yet when post is imported\n  b. Brand not be in Wayward Connect yet when post is imported\n  c. Brand does not exist on either\n  d. Happy Path: brand exists on boost + connect","autoResize":true,"lineHeight":1.25},{"id":"5Sy13Kwuu7FkU6GkEt0_y","type":"text","x":898.404315497705,"y":507.81583320721165,"width":773.739501953125,"height":150,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aP","roundness":null,"seed":1486277670,"version":375,"versionNonce":894026918,"isDeleted":false,"boundElements":[],"updated":1776972357441,"link":null,"locked":false,"text":"Relevant Account Fields\n1. fb_page_id\n2. ig_business_account_id\n3. ig_username (@ is unique but theoretically mutable for an ig account)\n\nWe pass in (1) and (2) for both accounts in partnership ads to Meta Pixel API","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Relevant Account Fields\n1. fb_page_id\n2. ig_business_account_id\n3. ig_username (@ is unique but theoretically mutable for an ig account)\n\nWe pass in (1) and (2) for both accounts in partnership ads to Meta Pixel API","autoResize":true,"lineHeight":1.25},{"id":"Qoti-9FD-GUQ5wNs-L8bk","type":"text","x":725.223964036758,"y":321.55361373186975,"width":333.5997619628906,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aS","roundness":null,"seed":446196730,"version":110,"versionNonce":1041579130,"isDeleted":false,"boundElements":[],"updated":1776971891425,"link":null,"locked":false,"text":"social_post.channel_account_id = \n1. fb_page_id\n2. ig_business_account_id","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"social_post.channel_account_id = \n1. fb_page_id\n2. ig_business_account_id","autoResize":true,"lineHeight":1.25},{"id":"U9uSYS_h4r6MhNJz_BzaY","type":"text","x":-629.7599918662299,"y":3331.1392454923325,"width":1472.0390625,"height":100,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aT","roundness":null,"seed":1283266234,"version":1279,"versionNonce":935139770,"isDeleted":false,"boundElements":[],"updated":1776976458895,"link":null,"locked":false,"text":"Other Questions\n1. Right now we allow fb + ig accounts to be changed on an account. This may cause complications later on\n2. Should we have a direct foreign key from social post -> creator account rather than on channelAccountId which isn't a real foreign key relationship.\n  This breaks if the user changes their fb / ig account ","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Other Questions\n1. Right now we allow fb + ig accounts to be changed on an account. This may cause complications later on\n2. Should we have a direct foreign key from 