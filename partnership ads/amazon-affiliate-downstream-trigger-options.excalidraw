 never delete\none row inserted = one newly observed financial delta\nbooked forever at (pair, granule, metric)","fontSize":14,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"st7","originalText":"STEP 7 — ANTI-JOIN + INSERT: append only candidates whose id\nis not already in the ledger; never update, never delete\none row inserted = one newly observed financial delta\nbooked forever at (pair, granule, metric)","lineHeight":1.25,"index":"as","autoResize":true},{"id":"st_sum","type":"rectangle","x":800,"y":1155,"width":660,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#fff3bf","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":60,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":222,"version":3,"versionNonce":222712047,"isDeleted":false,"boundElements":[{"id":"st_sum_t","type":"text"}],"updated":1781119222914,"link":null,"locked":false,"index":"at"},{"id":"st_sum_t","type":"text","x":955.0282440185547,"y":1177.5,"width":349.9435119628906,"height":35,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":223,"version":14,"versionNonce":704691791,"isDeleted":false,"boundElements":[],"updated":1781119222917,"link":null,"locked":false,"text":"steps 1-6 = pure function of manifest + prepared tables\nstep 7 = the only read of the ledger, and the only write","fontSize":14,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"st_sum","originalText":"steps 1-6 = pure function of manifest + prepared tables\nstep 7 = the only read of the ledger, and the only write","lineHeight":1.25,"index":"au","autoResize":true}],"appState":{"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{}}