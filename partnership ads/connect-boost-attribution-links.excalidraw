59075935,"link":null,"locked":false,"index":"ae"},{"id":"connect_source_text","type":"text","x":110,"y":925,"width":250,"height":168.75,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1053,"version":10,"versionNonce":896834287,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"CONNECT SOURCE (BigQuery)\nrisingtide.expert_product_links\n\nContains generated_link,\nexpert_id, product_id, type/version,\nactive state, and timestamps.\n\nThe URL already carries its\naa_* hashes.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"CONNECT SOURCE (BigQuery)\nrisingtide.expert_product_links\n\nContains generated_link,\nexpert_id, product_id, type/version,\nactive state, and timestamps.\n\nThe URL already carries its\naa_* hashes.","autoResize":false,"lineHeight":1.25,"baseline":164,"index":"af"},{"id":"identity_box","type":"rectangle","x":90,"y":1170,"width":290,"height":190,"angle":0,"strokeColor":"#ea580c","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1054,"version":2,"versionNonce":213419937,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"ag"},{"id":"identity_text","type":"text","x":110,"y":1188,"width":250,"height":150,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1055,"version":10,"versionNonce":958489871,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"IDENTITY BRIDGES\n\nexpert_id → creator account\nproduct_id → catalog connect_map\n             → retailer_product\n\nMissing creator or product means\nthe legacy link cannot be imported.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"IDENTITY BRIDGES\n\nexpert_id → creator account\nproduct_id → catalog connect_map\n             → retailer_product\n\nMissing creator or product means\nthe legacy link cannot be imported.","autoResize":false,"lineHeight":1.25,"baseline":154,"index":"ah"},{"id":"planner_box","type":"rectangle","x":440,"y":910,"width":300,"height":300,"angle":0,"strokeColor":"#ea580c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1056,"version":2,"versionNonce":1785260929,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"ai"},{"id":"planner_text","type":"text","x":462,"y":932,"width":256,"height":225,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1057,"version":10,"versionNonce":1559227183,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"LINK IMPORT PLANNER\n\n1. Scope rows to parent/catalog.\n2. Resolve creator + product FKs.\n3. Parse aa_campaignid,\n   aa_adgroupid, aa_creativeid,\n   and tag from the URL.\n4. Group by aa_adgroupid.\n5. Report unresolved rows.\n\nPreserves Connect URL + hashes.\nDoes not mint a new identity.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"LINK IMPORT PLANNER\n\n1. Scope rows to parent/catalog.\n2. Resolve creator + product FKs.\n3. Parse aa_campaignid,\n   aa_adgroupid, aa_creativeid,\n   and tag from the URL.\n4. Group by aa_adgroupid.\n5. Report unresolved rows.\n\nPreserves Connect URL + hashes.\nDoes not mint a new identity.","autoResize":false,"lineHeight":1.25,"baseline":254,"index":"aj"},{"id":"winner_box","type":"rectangle","x":800,"y":910,"width":260,"height":220,"angle":0,"strokeColor":"#ea580c","backgroundColor":"#fdba74","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1058,"version":2,"versionNonce":539087713,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"ak"},{"id":"winner_text","type":"text","x":820,"y":925,"width":220,"height":168.75,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1059,"version":10,"versionNonce":759737679,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"COLLISION WINNER + APPLY\n\nFor one hashed ad-group:\n1. active before inactive\n2. earliest created_at\n3. lowest Connect source ID\n\nWinner → attribution_link.\nLosers are only reported.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"COLLISION WINNER + APPLY\n\nFor one hashed ad-group:\n1. active before inactive\n2. earliest created_at\n3. lowest Connect source ID\n\nWinner → attribution_link.\nLosers are only reported.","autoResize":false,"lineHeight":1.25,"baseline":184,"index":"al"},{"id":"connect_map_box","type":"rectangle","x":800,"y":1180,"width":260,"height":180,"angle":0,"strokeColor":"#ea580c","backgroundColor":"#ffedd5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1060,"version":2,"versionNonce":573751105,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"am"},{"id":"connect_map_text","type":"text","x":820,"y":1197,"width":220,"height":131.25,"angle":0,"strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1061,"version":10,"versionNonce":360983407,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"connect_map PROVENANCE\n\nConnect link source ID\n→ Boost link UUID\n\nThis is rerun idempotency.\nIt is not keyed by the hash.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"connect_map PROVENANCE\n\nConnect link source ID\n→ Boost link UUID\n\nThis is rerun idempotency.\nIt is not keyed by the hash.","autoResize":false,"lineHeight":1.25,"baseline":144,"index":"an"},{"id":"connect_note_box","type":"rectangle","x":440,"y":1250,"width":300,"height":165,"angle":0,"strokeColor":"#d97706","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1062,"version":2,"versionNonce":788213537,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"ao"},{"id":"connect_note_text","type":"text","x":460,"y":1265,"width":260,"height":131.25,"angle":0,"strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1063,"version":10,"versionNonce":32171407,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"WHY MIGRATE THE LINK?\n\nWithout it, Boost sees Connect-\ntagged\nAmazon revenue but cannot reliably\nattach the historical creator and\nadvertised product.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WHY MIGRATE THE LINK?\n\nWithout it, Boost sees Connect-tagged\nAmazon revenue but cannot reliably\nattach the historical creator and\nadvertised product.","autoResize":false,"lineHeight":1.25,"baseline":129,"index":"ap"},{"id":"arrow_source_planner","type":"arrow","x":380,"y":1010,"width":60,"height":0,"angle":0,"strokeColor":"#ea580c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1064,"version":2,"versionNonce":216703745,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[60,0]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"aq"},{"id":"arrow_identity_planner","type":"arrow","x":380,"y":1260,"width":60,"height":110,"angle":0,"strokeColor":"#ea580c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1065,"version":2,"versionNonce":113625487,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[60,-110]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"ar"},{"id":"arrow_planner_winner","type":"arrow","x":740,"y":1020,"width":60,"height":0,"angle":0,"strokeColor":"#ea580c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1066,"version":2,"versionNonce":142645985,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[60,0]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"as"},{"id":"arrow_winner_pg","type":"arrow","x":930,"y":910,"width":0,"height":200,"angle":0,"strokeColor":"#ea5