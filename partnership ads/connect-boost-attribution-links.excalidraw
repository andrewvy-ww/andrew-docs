Family":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4. The resolved identity serves four different consumers","autoResize":false,"lineHeight":1.25,"baseline":29,"index":"aw"},{"id":"resolved_band","type":"rectangle","x":1350,"y":875,"width":800,"height":65,"angle":0,"strokeColor":"#9333ea","backgroundColor":"#e9d5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1072,"version":2,"versionNonce":1100799983,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"ax"},{"id":"resolved_band_text","type":"text","x":1380,"y":895,"width":740,"height":22.5,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1073,"version":9,"versionNonce":688655823,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"Amazon event + resolved creator + advertised product/link context","fontSize":18,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"Amazon event + resolved creator + advertised product/link context","autoResize":false,"lineHeight":1.25,"baseline":21,"index":"ay"},{"id":"billing_box","type":"rectangle","x":1180,"y":1000,"width":260,"height":340,"angle":0,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1074,"version":2,"versionNonce":33098255,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"az"},{"id":"billing_text","type":"text","x":1200,"y":1022,"width":220,"height":281.25,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1075,"version":10,"versionNonce":1929870319,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"BILLING\nAttribution revenue base\n\nLEFT JOIN by hash; unmatched\nevents stay visible.\n\nA hash resolves only when all\nrows\nagree on creator, product, and\nASIN.\n\nPurchased product—not\nadvertised\nproduct—drives downstream\nmoney.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"BILLING\nAttribution revenue base\n\nLEFT JOIN by hash; unmatched\nevents stay visible.\n\nA hash resolves only when all rows\nagree on creator, product, and ASIN.\n\nPurchased product—not advertised\nproduct—drives downstream money.","autoResize":false,"lineHeight":1.25,"baseline":292,"index":"b00"},{"id":"brand_report_box","type":"rectangle","x":1470,"y":1000,"width":260,"height":340,"angle":0,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1076,"version":2,"versionNonce":1435168815,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"b01"},{"id":"brand_report_text","type":"text","x":1490,"y":1022,"width":220,"height":243.75,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1077,"version":10,"versionNonce":1672488463,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"BRAND REPORTING\n\nUses distinct hash → creator\nmappings.\n\nLEFT JOIN preserves brand\nrevenue\nwhen no link resolves; creator is\nsimply unresolved.\n\nCreator filters and names use\nthe\nresolved identity.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"BRAND REPORTING\n\nUses distinct hash → creator\nmappings.\n\nLEFT JOIN preserves brand revenue\nwhen no link resolves; creator is\nsimply unresolved.\n\nCreator filters and names use the\nresolved identity.","autoResize":false,"lineHeight":1.25,"baseline":292,"index":"b02"},{"id":"creator_report_box","type":"rectangle","x":1760,"y":1000,"width":260,"height":340,"angle":0,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1078,"version":2,"versionNonce":1178276431,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"b03"},{"id":"creator_report_text","type":"text","x":1780,"y":1022,"width":220,"height":262.5,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1079,"version":10,"versionNonce":704547887,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"CREATOR REPORTING\n\nFirst filters link rows to the\nrequesting creator.\n\nINNER JOIN by hash is part of\nthe\ntenant boundary: only that\ncreator's\nmapped events appear.\n\nUnmapped legacy links mean\nmissing\ncreator history.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"CREATOR REPORTING\n\nFirst filters link rows to the\nrequesting creator.\n\nINNER JOIN by hash is part of the\ntenant boundary: only that creator's\nmapped events appear.\n\nUnmapped legacy links mean missing\ncreator history.","autoResize":false,"lineHeight":1.25,"baseline":292,"index":"b04"},{"id":"publisher_report_box","type":"rectangle","x":2050,"y":1000,"width":260,"height":340,"angle":0,"strokeColor":"#9333ea","backgroundColor":"#f3e8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1080,"version":2,"versionNonce":216133743,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"b05"},{"id":"publisher_report_text","type":"text","x":2070,"y":1022,"width":220,"height":243.75,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1081,"version":10,"versionNonce":31141455,"isDeleted":false,"boundElements":[],"updated":1785259088637,"link":null,"locked":false,"text":"PUBLISHER REPORTING\n\nFilters attribution_link to the\npublisher.\n\nFor a re-minted hash, chooses\nthe\nearliest link row.\n\nINNER JOIN returns event\nmetrics\nplus link, brand, product, and\ntracking context.","fontSize":15,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PUBLISHER REPORTING\n\nFilters attribution_link to the\npublisher.\n\nFor a re-minted hash, chooses the\nearliest link row.\n\nINNER JOIN returns event metrics\nplus link, brand, product, and\ntracking context.","autoResize":false,"lineHeight":1.25,"baseline":292,"index":"b06"},{"id":"consumer_note_box","type":"rectangle","x":1260,"y":1380,"width":980,"height":75,"angle":0,"strokeColor":"#7e22ce","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1082,"version":2,"versionNonce":860359311,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"b07"},{"id":"consumer_note_text","type":"text","x":1290,"y":1398,"width":920,"height":40,"angle":0,"strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1083,"version":10,"versionNonce":371100783,"isDeleted":false,"boundElements":[],"updated":1785259088638,"link":null,"locked":false,"text":"Important: the Publisher API's get/list endpoints do not query by this hash. The hash is currently an analytical resolution key\nused in BigQuery.","fontSize":16,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"Important: the Publisher API's get/list endpoints do not query by this hash. The hash is currently an analytical resolution key used in BigQuery.","autoResize":false,"lineHeight":1.25,"baseline":36,"index":"b08"},{"id":"arrow_resolver_band","type":"arrow","x":2040,"y":690,"width":290,"height":185,"angle":0,"strokeColor":"#7e22ce","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1084,"version":2,"versionNonce":1982193839,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[0,95],[-290,95],[-290,185]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"b09"},{"id":"arrow_band_billing","type":"arrow","x":1510,"y":940,"width":200,"height":60,"angle":0,"strokeColor":"#9333ea","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1085,"version":2,"versionNonce":1344865729,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[-200,60]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"b0A"},{"id":"arrow_band_brand","type":"arrow","x":1630,"y":940,"width":30,"height":60,"angle":0,"strokeColor":"#9333ea","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1086,"version":2,"versionNonce":1730409167,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[-30,60]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"b0B"},{"id":"arrow_band_creator","type":"arrow","x":1870,"y":940,"width":20,"height":60,"angle":0,"strokeColor":"#9333ea","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1087,"version":2,"versionNonce":56927649,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[20,60]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"b0C"},{"id":"arrow_band_publisher","type":"arrow","x":1990,"y":940,"width":190,"height":60,"angle":0,"strokeColor":"#9333ea","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":1088,"version":2,"versionNonce":1322959087,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"points":[[0,0],[190,60]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"index":"b0D"},{"id":"footer_box","type":"rectangle","x":50,"y":1520,"width":2300,"height":95,"angle":0,"strokeColor":"#334155","backgroundColor":"#f8fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1090,"version":2,"versionNonce":836848001,"isDeleted":false,"boundElements":[],"updated":1785259075935,"link":null,"locked":false,"index":"b0E"},{"id":"footer_text","type":"text","x":80,"y":1540,"width":2240,"height":45,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1091,"version":9,"versionNonce":579937935,"isDeleted":false,"boundElements":[],"updated":1785259088638,"link":null,"locked":false,"text":"MENTAL MODEL: PostgreSQL stores the operational link record. Amazon emits facts carrying the opaque ad-group key. BigQuery joins that key back to the link.\nMigrating Connect links fills the historical key → creator/product dictionary; it does not recreate sales, reprice them, or generate replacement URLs.","fontSize":18,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"MENTAL MODEL: PostgreSQL stores the operational link record. Amazon emits facts carrying the opaque ad-group key. BigQuery joins that key back to the link.\nMigrating Connect links fills the historical key → creator/product dictionary; it does not recreate sales, reprice them, or generate replacement URLs.","autoResize":false,"lineHeight":1.25,"baseline":49,"index":"b0F"}],"appState":{"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{}}