ough LEFT JOIN","lineHeight":1.25,"angle":0,"fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1101796665,"version":527,"versionNonce":1460678425,"isDeleted":false,"boundElements":[],"updated":1779154974911,"link":null,"locked":false,"backgroundColor":"transparent","index":"b20","autoResize":true},{"id":"a5O4HpctN0fXsM9tg2PJ6","type":"text","x":442.86191633051243,"y":200.935926317334,"width":213.63180541992188,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b21","roundness":null,"seed":1913528931,"version":232,"versionNonce":2040192291,"isDeleted":false,"boundElements":[],"updated":1779199993718,"link":null,"locked":false,"text":"site is a column but not PK","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"site is a column but not PK","autoResize":true,"lineHeight":1.25},{"id":"H9HmrijZcbBAmZG_aLFiB","type":"text","x":568.2770816973056,"y":323.5664126228633,"width":352.73565673828125,"height":20,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b22","roundness":null,"seed":1677642157,"version":41,"versionNonce":1432167705,"isDeleted":false,"boundElements":[],"updated":1779202556747,"link":null,"locked":false,"text":"PK: date, tracking_id, retailer, same as above","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PK: date, tracking_id, retailer, same as above","autoResize":true,"lineHeight":1.25},{"id":"gxWc0OUeq0I-jYyEebZlF","type":"text","x":1055.9891779690824,"y":399.00776792559424,"width":473.7275390625,"height":20,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b24","roundness":null,"seed":1550970115,"version":44,"versionNonce":335872493,"isDeleted":false,"boundElements":[],"updated":1779200649877,"link":null,"locked":false,"text":"unified_with_normalized_sites (maps legacy site -> new site)","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"unified_with_normalized_sites (maps legacy site -> new site)","autoResize":true,"lineHeight":1.25},{"id":"qCTxzsKNsPrT9fWfg3c38","type":"text","x":2270.220794388411,"y":337.6286737005427,"width":230.68780517578125,"height":20,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b25","roundness":null,"seed":1563946029,"version":68,"versionNonce":1933372183,"isDeleted":false,"boundElements":[],"updated":1779202454337,"link":null,"locked":false,"text":"PK: date, tracking_id, retailer","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PK: date, tracking_id, retailer","autoResize":true,"lineHeight":1.25},{"id":"rkv8psYWHqzyoNFG8rjnp","type":"text","x":-1502.0105266791147,"y":195.7683799554659,"width":875.1514892578125,"height":500,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b29","roundness":null,"seed":236511735,"version":480,"versionNonce":1066978457,"isDeleted":false,"boundElements":[],"updated":1779202290340,"link":null,"locked":false,"text":"Ex: NBC + Shop Today share impact with site = NBC. They have separate meta account + spend\n\nWe override here through pageview from site = NBCto site = Shop Today\n\n  account_id=7,  account_name=\"Hyphensocial // NBC Select\",  site=\"NBC Select\",  etl_site_id → \"NBC\"\n  account_id=8,  account_name=\"Hyphensocial // Shop Today\",  site=\"Shop Today\",  etl_site_id → \"NBC\"   ← same etl_site\n\ncanonical.session has rows linking each unique_id to the site_id from the publisher's pixel:\n\n  unique_id=\"hyphen111\", site_id=\"Shop Today\"     ← reader was on shop-today.com when they clicked\n  unique_id=\"hyphen222\", site_id=\"NBC\"            ← reader was on nbcselect.com (pixel stamps as \"NBC\" or \"NBC Select\")\n\npageview_site_mapping joins on tracking_id = unique_id and produces mapped_site. For each tracking_id:\n\n  - hyphen111 → pageview says \"Shop Today\" → COALESCE picks \"Shop Today\"\n  - hyphen222 → pageview says \"NBC\" → COALESCE picks \"NBC\"\n\nunified_with_normalized_sites\n\n  Then the CASE ladder cleans up the remaining strings:\n\n  CASE\n    WHEN site = 'Strategist'    THEN 'The Strategist'\n\n","fontSize":16,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Ex: NBC + Shop Today share impact with site = NBC. They have separate meta account + spend\n\nWe override here through pageview from site = NBCto site = Shop Today\n\n  account_id=7,  account_name=\"Hyphensocial // NBC Select\",  site=\"NBC Select\",  etl_site_id → \"NBC\"\n  account_id=8,  account_name=\"Hyphensocial // Shop Today\",  site=\"Shop Today\",  etl_site_id → \"NBC\"   ← same etl_site\n\ncanonical.session has rows linking each unique_id to the site_id from the publisher's pixel:\n\n  unique_id=\"hyphen111\", site_id=\"Shop Today\"     ← reader was on shop-today.com when they clicked\n  unique_id=\"hyphen222\", site_id=\"NBC\"            ← reader was on nbcselect.com (pixel stamps as \"NBC\" or \"NBC Select\")\n\npageview_site_mapping joins on tracking_id = unique_id and produces mapped_site. For each tracking_id:\n\n  - hyphen111 → pageview says \"Shop Today\" → COALESCE picks \"Shop Today\"\n  - hyphen222 → pageview says \"NBC\" → COALESCE picks \"NBC\"\n\nunified_with_normalized_sites\n\n  Then the CASE ladder cleans up the remaining strings:\n\n  CASE\n    WHEN site = 'Strategist'    THEN 'The Strategist'\n\n","autoResize":true,"lineHeight":1.25},{"id":"ya4veg_1oo4qs1Vv-EtuM","type":"text","x":2563.244138270683,"y":610.8223408591844,"width":601.199462890625,"height":20,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2E","roundness":null,"seed":318765709,"version":136,"versionNonce":707809623,"isDeleted":false,"boundElements":[],"updated":1779202457585,"link":null,"locked":false,"text":"We resolve meta_account_id -> account_id through adservice federated view","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"We resolve meta_account_id -> account_id through adservice federated view","autoResize":true,"lineHeight":1.25},{"id":"pZyBWmof5MxY_f_5jX5oq","type":"text","x":2958.060709541655,"y":20.887714759321454,"width":266.75177001953125,"height":20,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2F","roundness":null,"seed":693652055,"version":345,"versionNonce":536965315,"isDeleted":false,"boundElements":[],"updated":1779206064805,"link":null,"locked":false,"text":"account_name no longer necessary","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"account_name no longer necessary","autoResize":true,"lineHeight":1.25},{"id":"nzjAU4izpo9SrSgpjaBbO","type":"text","x":269.2654989813889,"y":265.81289024270654,"width":278.62371826171875,"height":20,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2H","roundn