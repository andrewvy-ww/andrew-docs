"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1g","roundness":null,"seed":1509565399,"version":276,"versionNonce":1005784295,"isDeleted":false,"boundElements":[],"updated":1779151254401,"link":null,"locked":false,"text":"This computes site with specific overrides using affiliate_partners.site as fallback\n","fontSize":17.30428930576955,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"This computes site with specific overrides using affiliate_partners.site as fallback\n","autoResize":true,"lineHeight":1.25},{"id":"ipm1FvyEk5gELcN3PQaUX","type":"arrow","x":1357.0597205288234,"y":661,"width":942.4127704281127,"height":350.9999999999998,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1i","roundness":null,"seed":1561578311,"version":512,"versionNonce":1333574393,"isDeleted":false,"boundElements":[{"type":"text","id":"kJvu3jzmHa9geezKsXQSm"}],"updated":1779204975726,"link":null,"locked":false,"points":[[0,0],[0,330.9039002702716],[-942.4127704281127,330.9039002702716],[-942.4127704281127,350.9999999999998]],"startBinding":{"elementId":"el43","mode":"orbit","fixedPoint":[0.7526406673446454,1.0461538461538462]},"endBinding":{"elementId":"el87","mode":"orbit","fixedPoint":[0.7204749040398283,-0.2727272727272831]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"fixedSegments":[{"index":2,"start":[0,330.9039002702716],"end":[-942.4127704281127,330.9039002702716]}],"startIsSpecial":false,"endIsSpecial":false},{"id":"kJvu3jzmHa9geezKsXQSm","type":"text","x":685.8095773452773,"y":981.9039002702716,"width":202.92779541015625,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1iV","roundness":null,"seed":2065166951,"version":50,"versionNonce":1019421351,"isDeleted":false,"boundElements":[],"updated":1779152441114,"link":null,"locked":false,"text":"aggregate by account.site","fontSize":16,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"ipm1FvyEk5gELcN3PQaUX","originalText":"aggregate by account.site","autoResize":true,"lineHeight":1.25},{"id":"EboaRSfw9aCaTQjHxeK21","type":"text","x":49.394058964912404,"y":606.3706174437176,"width":213.63180541992188,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1j","roundness":null,"seed":1905547335,"version":55,"versionNonce":911862791,"isDeleted":false,"boundElements":[],"updated":1779151818569,"link":null,"locked":false,"text":"site is a column but not PK","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"site is a column but not PK","autoResize":true,"lineHeight":1.25},{"id":"q-zX8kSDGquPOj3NN7D_3","type":"text","x":-138.89728165470746,"y":895.689273800554,"width":213.63180541992188,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1k","roundness":null,"seed":1813809897,"version":181,"versionNonce":1930201065,"isDeleted":false,"boundElements":[],"updated":1779152693366,"link":null,"locked":false,"text":"site is a column but not PK","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"site is a column but not PK","autoResize":true,"lineHeight":1.25},{"id":"4vzyWp9Me8ijxMqH5r6Ow","type":"text","x":48.37987774841827,"y":198.7616842667856,"width":213.63180541992188,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1l","roundness":null,"seed":2037478759,"version":186,"versionNonce":1477099043,"isDeleted":false,"boundElements":[],"updated":1779205756966,"link":null,"locked":false,"text":"site is a column but not PK","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"site is a column but not PK","autoResize":true,"lineHeight":1.25},{"id":"9l-llfEgQGwxg5YVxduNO","type":"text","x":387.1172875293779,"y":905.913149123573,"width":213.63180541992188,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1n","roundness":null,"seed":672077161,"version":155,"versionNonce":1724664393,"isDeleted":false,"boundElements":[],"updated":1779152774096,"link":null,"locked":false,"text":"site is a column but not PK","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"site is a column but not PK","autoResize":true,"lineHeight":1.25},{"id":"spaZKjWYgANSYff4eVn1l","type":"text","x":-1780.8062652650956,"y":984.520655244137,"width":953.7911987304688,"height":580,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1s","roundness":null,"seed":476028423,"version":756,"versionNonce":687816813,"isDeleted":false,"boundElements":[],"updated":1779207108749,"link":null,"locked":false,"text":"affiliate_sales_daily_by_user_params is only necessary becomes of amazon\n\nProblem: \n\n    We want to know which ad drove this purchase ( which click-> which ad -> which user)\n    \n    Amazon Asssociates does not accept arbitrary unique tracking ids.\n    We precreate them and then have them used in rotation \n    Ex: popsugar3-20\n    \n    What we can get from Amazon: popsugar3-20 earned $1000 today\n    - This tag could be used for multiple clicks, multiple readers, multiple ads\n\nSolution:\n\n      For each amz_tag, look at our pageview data to figure out which readers saw the tag rotate to them, and when.\n    \n      Two cases:\n      - Assignment day (multiple readers first saw the tag the same day) → split that day's revenue 1/N equally across them\n      - Carry-forward (days between assignments) → 100% credit to the most recently assigned reader, until the next assignment day\n    \n      Now each Amazon revenue dollar maps to a specific unique_id (reader).\n    \n      Then the chain works:\n    \n      unique_id → canonical.session.params.utm_term → matches ad_name or ext_ad_id → ad-level attribution\n\nSee example: https://docs.google.com/document/d/1ugyDUHD7ZCFplRY5VftQLCi3aTQX_E9lylw3ICoBu-U/edit?usp=sharing\n","fontSize":16,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"affiliate_sales_daily_by_user_params is only necessary becomes of amazon\n\nProblem: \n\n    We want to know which ad drove this purchase ( which click-> which ad -> which user)\n    \n    Amazon Asssociates does not accept arbitrary unique tracking ids.\n    We precreate them and then have them used in rotation \n    Ex: popsugar3-20\n    \n    What we can get from Amazon: popsugar3-20 earned $1000 today\n    - This tag could be used for multiple clicks, multiple readers, multiple ads\n\nSolution:\n\n      For each amz_tag, look at our pageview data to figure out which readers saw the tag rotate to them, and when.\n    \n      Two cases:\n      - Assignment day (multiple readers first saw the tag the same day) → split that day's revenue 1/N equally across them\n      - Carry-forward (days between assignments) → 100% credit to the most recently assigned reader, until the next assignment day\n    \n      Now each Amazon revenue dollar maps to a specific unique_id (reader).\n    \n      Then the chain works:\n    \n      unique_id → canonical.session.params.utm_term → matches ad_name or ext_ad_id → ad-level attribution\n\nSee example: https://docs.google.com/document/d/1ugyDUHD7ZCFplRY5VftQLCi3aTQX_E9lylw3ICoBu-U/edit?usp=sharing\n","autoResize":true,"lineHeight":1.25},{"id":"m2qgxAPCn3_nikqrFFvvG","type":"rectangle","x":356.83621076913266,"y":713.4488846009361,"width":777.1133881125687,"height":240.56998471058523,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1t","roundness":{"type":3},"seed":1960029543,"version":323,"versionNonce":1376399689,"isDeleted":false,"boundElements":[],"updated":1779153506735,"link":null,"locked":false},{"id":"el119","type":"arrow","x":640,"y":751.8098842166033,"width":136.5142736307888,"height":1.2764198017217723,"strokeColor":"#c92a2a","points":[[0,0],[136.5142736307888,1.2764198017217723]],"lastCommittedPoint":null,"startBinding":null,"endBinding":{"elementId":"el60","mode":"orbit","fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","angle":0,"fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1,"version":43,"versionNonce":1125751639,"isDeleted":false,"boundElements":[],"updated":1779154389493,"link":null,"locked":false,"backgroundColor":"transparent","index":"b1tG","moveMidPointsWithElement":false},{"id":"el121","type":"arrow","x":640,"y":912,"width":136.54377435579863,"height":3.477355432018726,"strokeColor":"#c92a2a","points":[[0,0],[136.54377435579863,-3.477355432018726]],"lastCommittedPoint":null,"startBinding":null,"endBinding":{"elementId":"el66","mode":"orbit","fixedPoint":[0,0.5001]},"startArrowhead":null,"endArrowhead":"arrow","angle":0,"fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,