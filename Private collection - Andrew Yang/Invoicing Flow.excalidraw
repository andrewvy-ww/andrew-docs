4867840956,-0.05888634801197096]},"endBinding":{"elementId":"Nm-ho9JiZrR1bPHiLrBzn","mode":"orbit","fixedPoint":[0.49946260259882075,1.0794249961218263]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"fixedSegments":null,"startIsSpecial":null,"endIsSpecial":null},{"id":"Km3GKPznQ0Ffh_gU3WqHO","type":"text","x":291.62933440915134,"y":884.0180375509652,"width":806.0987548828125,"height":1000,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0E","roundness":null,"seed":1284481046,"version":1324,"versionNonce":35115866,"isDeleted":false,"boundElements":[],"updated":1782163607078,"link":null,"locked":false,"text":"For each abstract brand \n    - brand default commission for all products\n    - product_comissions  (abstract brand id, product asin, creator [expert])\n    - brand_usage_rate (Wayward fee on GMV)\n\nOrder of checks (highest precedence -> lowest precedence)\n    1. Check if there is a deal for that creator AND that product (this is creator specific rate)\n    2. Check product default rate\n            This in time bound - same for any commission\n    3. Check brand default rate\n\n\n1. get attributed sales for the month\n\n   creator | ASIN |  sales | rate-resolution           | commission | usage_fee(5%)\n   --------+------+--------+---------------------------+-----------+--------------\n   Dana    | B01  | 1000.00| expert(Dana,B01)=18%      |   180.00  |    50.00\n   Dana    | B01  | -200.00| (return, same 18%)        |   -36.00  |   -10.00\n   Evan    | B01  |  500.00| product default 15%       |    75.00  |    25.00\n\n2. aggregate to brand invoice\n\n  commission (→ creators):  180 − 36 + 75 + 80          = 299.00\n     Dana:  180 − 36 = 144.00\n     Evan:  75 + 80  = 155.00\n  usage fee (→ Wayward):    50 − 10 + 25 + 20           =  85.00\n                                              invoice total = 384.00\n\n3. Export to stripe\ndraft -> finalize -> due\n\n4. Creator gets paid after brand pays\n\n    Acme pays Wayward $384\n    Wayward keeps $85 (usage fee)\n    Dana paid $144 (commission)\n    Evan paid $155 (commission)\n\nQuestion: Express this as an equation?\n","fontSize":20,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"For each abstract brand \n    - brand default commission for all products\n    - product_comissions  (abstract brand id, product asin, creator [expert])\n    - brand_usage_rate (Wayward fee on GMV)\n\nOrder of checks (highest precedence -> lowest precedence)\n    1. Check if there is a deal for that creator AND that product (this is creator specific rate)\n    2. Check product default rate\n            This in time bound - same for any commission\n    3. Check brand default rate\n\n\n1. get attributed sales for the month\n\n   creator | ASIN |  sales | rate-resolution           | commission | usage_fee(5%)\n   --------+------+--------+---------------------------+-----------+--------------\n   Dana    | B01  | 1000.00| expert(Dana,B01)=18%      |   180.00  |    50.00\n   Dana    | B01  | -200.00| (return, same 18%)        |   -36.00  |   -10.00\n   Evan    | B01  |  500.00| product default 15%       |    75.00  |    25.00\n\n2. aggregate to brand invoice\n\n  commission (→ creators):  180 − 36 + 75 + 80          = 299.00\n     Dana:  180 − 36 = 144.00\n     Evan:  75 + 80  = 155.00\n  usage fee (→ Wayward):    50 − 10 + 25 + 20           =  85.00\n                                              invoice total = 384.00\n\n3. Export to stripe\ndraft -> finalize -> due\n\n4. Creator gets paid after brand pays\n\n    Acme pays Wayward $384\n    Wayward keeps $85 (usage fee)\n    Dana paid $144 (commission)\n    Evan paid $155 (commission)\n\nQuestion: Express this as an equation?\n","autoResize":true,"lineHeight":1.25},{"id":"07V7gRun0-jd2jd2kTOdt","type":"rectangle","x":1832.6782398006953,"y":869.325604