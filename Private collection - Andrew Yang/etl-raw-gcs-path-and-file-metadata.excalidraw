NFpRb5TOQoB26W6s0S","type":"text","x":414.22412109375,"y":558.41796875,"width":835.9988403320312,"height":660,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aB","roundness":null,"seed":324647067,"version":1082,"versionNonce":543817653,"isDeleted":false,"boundElements":null,"updated":1780592581914,"link":null,"locked":false,"text":"integration credential id first THEN date\n\nbucket/<affiliate network>/<endpoint>/{integration_cred_id}/yyyy/mm/dd/<filename> \n\n\nstartdate enddate don't belong in file name, this should be file metadata\nWe can also store the api request we made in a specific format common to all the file payloads.\n\nfile metadata we should store IF AVAILABLE\n{\n    affiliate_network:\"impact\",\n    endpoint: \"subid\",\n    internal_id_key: \"integration_credential_id\" // or seller_account\n    internal_id_value: \"...\",\n    external_id_key: \"SID\",\n    external_id_value: \"...\",\n    event_start_date:,\n    event_end_date:\n}\n \n\n\nOr in the file payload we store \n\n{\n    \"request\": [...],\n    \"payload\": [...]\n}\n\nIn my opinion we should do both GCS metadata + file payload modification\n\nOpen question\n1. What's the filename","fontSize":16,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"integration credential id first THEN date\n\nbucket/<affiliate network>/<endpoint>/{integration_cred_id}/yyyy/mm/dd/<filename> \n\n\nstartdate enddate don't belong in file name, this should be file metadata\nWe can also store the api request we made in a specific format common to all the file payloads.\n\nfile metadata we should store IF AVAILABLE\n{\n    affiliate_network:\"impact\",\n    endpoint: \"subid\",\n    internal_id_key: \"integration_credential_id\" // or seller_account\n    internal_id_value: \"...\",\n    external_id_key: \"SID\",\n    external_id_value: \"...\",\n    event_start_date:,\n    event_end_date:\n}\n \n\n\nOr in the file payload we store \n\n{\n    \"request\": [...],\n    \"payload\": [...]\n}\n\nIn my opinion we should do both GCS metadata + file payload modification\n\nOpen question\n1. What's the filename","autoResize":true,"lineHeight":1.25}],"appState":{"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{}}