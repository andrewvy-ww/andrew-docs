g between \nlast invoiced date -> last day month\nJuly 1 -> July 31 inclusive\n\nJoins event data -> effective commission\nprints out rows -> \n\ninvoice_lines\ninvoice-id, program, ingest_date, delta, commision\n\ninvoice\n\n\nStripe\n- group it like connect\n\n","fontSize":28,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Scan through for all events in the event log between \nlast invoiced date -> last day month\nJuly 1 -> July 31 inclusive\n\nJoins event data -> effective commission\nprints out rows -> \n\ninvoice_lines\ninvoice-id, program, ingest_date, delta, commision\n\ninvoice\n\n\nStripe\n- group it like connect\n\n","autoResize":true,"lineHeight":1.25},{"id":"QnBKPI9kNVSjhdA7lrrtx","type":"rectangle","x":4586.346906352043,"y":541.4276848569212,"width":366.50551202368206,"height":107.46261305815892,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0k","roundness":{"type":3},"seed":696467491,"version":92,"versionNonce":1586667139,"isDeleted":false,"boundElements":[{"type":"text","id":"GCAqykBGuOPVTFlthMoux"},{"id":"_qprwwh_TEodHW2OtGKzz","type":"arrow"}],"updated":1783014395061,"link":null,"locked":false},{"id":"GCAqykBGuOPVTFlthMoux","type":"text","x":4629.907737315056,"y":560.1589913860007,"width":279.38385009765625,"height":70,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0l","roundness":null,"seed":1425164963,"version":69,"versionNonce":1812693315,"isDeleted":false,"boundElements":null,"updated":1783014371235,"link":null,"locked":false,"text":"invoice_line\n- one line per granule ","fontSize":28,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"QnBKPI9kNVSjhdA7lrrtx","originalText":"invoice_line\n- one li