.611328125,95.42773437499989]],"startBinding":{"elementId":"R471162pcDSsUlvaS9mkO","mode":"orbit","fixedPoint":[0.49950755972761884,1.11294948157953]},"endBinding":{"elementId":"ABG9qt5oUgxybsj46-3aQ","mode":"orbit","fixedPoint":[0.499546653916308,-0.10461789946873723]},"startArrowhead":null,"endArrowhead":"arrow","elbowed":true,"fixedSegments":null,"startIsSpecial":null,"endIsSpecial":null},{"id":"33V__jcAD8QfH6Y2bMdjK","type":"text","x":690.108728038618,"y":1079.2190292380083,"width":1365.041015625,"height":275,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ah","roundness":null,"seed":249796076,"version":521,"versionNonce":134333524,"isDeleted":false,"boundElements":[],"updated":1781880079280,"link":null,"locked":false,"text":"In simple setup case this is how the campaign objective is set\n\nany destination is Amazon            → OUTCOME_TRAFFIC\nany destination is an article        → OUTCOME_LEADS (we need to come up with a better solution to this\nany destination matches account site → OUTCOME_LEADS (we need to get rid of this, articlepatterns should cover this)\notherwise                        → OUTCOME_SALES\n\nWhen a campaign's objective is set, we derive one optimization goal from the objective\nand one promoted_object from (objective + the chosen pixel ▎event), and apply both uniformly to every ad set in that launch.\n\n","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"In simple setup case this is how the campaign objective is set\n\nany destination is Amazon            → OUTCOME_TRAFFIC\nany destination is an article        → OUTCOME_LEADS (we need to come up with a better solution to this\nany destination matches account site → OUTCOME_LEADS (we need to get rid of this, articlepatterns should cover this)\notherwise                        → OUTCOME_SALES\n\nWhen a campaign's objective is set, we derive one optimization goal from the objective\nand one promoted_object from (objective + the chosen pixel ▎event), and apply both uniformly to every ad set in that launch.\n\n","autoResize":true,"lineHeight":1.25},{"id":"0R1avv3J_PpJI1TLO1NiA","type":"text","x":-59.59508030808769,"y":748.0931333292878,"width":1507,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ai","roundness":null,"seed":355518804,"version":189,"versionNonce":1457984212,"isDeleted":false,"boundElements":[],"updated":1781842381655,"link":null,"locked":false,"text":"A Meta pixel is a small piece of tracking code that a website puts on its pages. Its whole job is to watch what visitors do on that site \n  and report those actions back to Meta. They belong to a business\n\nAn event is one labeled thing that happened, sent to the pixel. Every time a visitor does something noteworthy, the site fires an event\n  with a name: AffiliateClick, ...","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"A Meta pixel is a small piece of tracking code that a website puts on its pages. Its whole job is to watch what visitors do on that site \n  and report those actions back to Meta. They belong to a business\n\nAn event is one labeled thing that happened, sent to the pixel. Every time a visitor does something noteworthy, the site fires an event\n  with a name: AffiliateClick, ...","autoResize":true,"lineHeight":1.25},{"id":"_gQ9vvXyUdXjlPN33kCoV","type":"text","x":-714.4445318419487,"y":1236.4030317329489,"width":594,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aj","roundness":null,"seed":480935508,"version":185,"versionNonce":1706896340,"isDeleted":false,"boundElements":[],"updated":1781844040935,"link":null,"locked":false,"text":" The objective doesn't contain the pixel event,\nit constrains what optimization goal + promoted_object\nare legal on the ad sets beneath it.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":" The objective doesn't contain the pixel event,\nit constrains what optimization goal + promoted_object\nare legal on the ad sets beneath it.","autoResize":true,"lineHeight":1.25},{"id":"cV3-VDD_v8_s4XkwIfSUj","type":"text","x":734.625597146926,"y":2127.1874110228264,"width":957,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ak","roundness":null,"seed":2018542444,"version":213,"versionNonce":540869996,"isDeleted":false,"boundElements":[],"updated":1781845720886,"link":null,"locked":false,"text":"CustomConversionId is different for account.\nWe create it on meta accounts when they onboard for AffiliateClick (eventType = OTHER) ","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"CustomConversionId is different for account.\nWe create it on meta accounts when they onboard for AffiliateClick (eventType = OTHER) ","autoResize":true,"lineHeight":1.25},{"id":"t3VsRuUgEnU5aXiSmbMkV","type":"text","x":69.76988281153331,"y":2314.6929424263126,"width":1254,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ao","roundness":null,"seed":1331461612,"version":291,"versionNonce":1748903276,"isDeleted":false,"boundElements":[],"updated":1781845775182,"link":null,"locked":false,"text":"How to fix this? \n- We need a PURCHASE pixel event on the brand pixel\n- We need a LEADS AffiliateClick conversion event or we need to prevent LEADS from ever being selected for a brand\n\n","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"How to fix this? \n- We need a PURCHASE pixel event on the brand pixel\n- We need a LEADS AffiliateClick conversion event or we need to prevent LEADS from ever being selected for a brand\n\n","autoResize":true,"lineHeight":1.25},{"id":"rY44mAeWNZlfIC-o5xX0E","type":"text","x":-613.1484469891341,"y":1407.1176470140435,"width":473,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ar","roundness":null,"seed":856548460,"version":59,"versionNonce":372042988,"isDeleted":false,"boundElements":[],"updated":1781879463414,"link":null,"locked":false,"text":"For Brands, only SALES / TRAFFIC is enabled","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"For Brands, only SALES / TRAFFIC is enabled","autoResize":true,"lineHeight":1.25},{"id":"VWh5qrVDWAodteULapvED","type":"text","x":-859.0633000509378,"y":1490.741789044574,"width":231,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"as","roundness":null,"seed":1063924972,"version":23,"versionNonce":546651116,"isDeleted":false,"boundElements":[],"updated":1781879672188,"link":null,"locked":false,"text":"For partnership ads, ","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"For partnership ads, ","autoResize":true,"lineHeight":1.25}],"appState":{"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{}}