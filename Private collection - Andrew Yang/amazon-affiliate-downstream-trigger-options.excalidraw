rce\n        WORKFLOW: listEligibleAccounts \n        WORKFLOW: fetchAccount\n            WORKFLOW: fetchReport\n                fetchReport one per (type, seller account id, ingest date)\n                pullReportPage ... for loop (each page puts to GCS)\n\n\n                NEW: loadPreparedSnapshot (gets GCS payload paths)\n                ","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WORKFLOW: fetchAll (fetch-all-...)\n    fetchSource\n        WORKFLOW: listEligibleAccounts \n        WORKFLOW: fetchAccount\n            WORKFLOW: fetchReport\n                fetchReport one per (type, seller account id, ingest date)\n                pullReportPage ... for loop (each page puts to GCS)\n\n\n                NEW: loadPreparedSnapshot (gets GCS payload paths)\n                ","autoResize":true,"lineHeight":1.25},{"id":"kU32b_N8tmD-i4yu334AH","type":"text","x":-1131.8251681857637,"y":565.4377034505204,"width":990,"height":150,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aY","roundness":null,"seed":932708800,"version":51,"versionNonce":1275916864,"isDeleted":false,"boundElements":[],"updated":1781117395717,"link":null,"locked":false,"text":"Ever run the cron goes through every manifest\n\n\n  candidates = compute_diffs(ALL manifest pairs)     # same answer every run for old pairs\n  new_rows   = candidates − ledger                   # set difference on ledger_entry_id\n  ledger    += new_rows","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Ever run the cron goes through every manifest\n\n\n  candidates = compute_diffs(ALL manifest pairs)     # same answer every run for old pairs\n  new_rows   = candidates − ledger                   # set difference on ledger_entry_id\n  ledger    += new_rows","autoResize":true,"lineHeight":1.25}],"appState":{"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{}}