      "seed": 1531872762,
      "version": 30,
      "versionNonce": 306238778,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783053490550,
      "link": null,
      "locked": false,
      "text": "  ┌───────────────────┬─────────────────────────┬──────────────────────────────┬───────┐\n  │     FK holder     │         column          │         → references         │ card. │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ amz_brand_tokens  │ brand_id                │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ amz_ad_profiles   │ brand_id                │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ brands (ABSTRACT) │ parent_brand_id         │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ brands (PROFILE)  │ parent_brand_id         │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ abstract_brand_id       │ brands (ABSTRACT)            │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ amz_profile_id          │ amz_ad_profiles              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ storefronts       │ brand_id                │ brands                       │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ storefronts       │ profile_id              │ amz_ad_profiles              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ amz_brand_name (string) │ derives ABSTRACT (not an FK) │ —     │\n  └───────────────────┴─────────────────────────┴──────────────────────────────┴───────┘",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  ┌───────────────────┬─────────────────────────┬──────────────────────────────┬───────┐\n  │     FK holder     │         column          │         → references         │ card. │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ amz_brand_tokens  │ brand_id                │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ amz_ad_profiles   │ brand_id                │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ brands (ABSTRACT) │ parent_brand_id         │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ brands (PROFILE)  │ parent_brand_id         │ brands (PARENT)              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ abstract_brand_id       │ brands (ABSTRACT)            │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ amz_profile_id          │ amz_ad_profiles              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ storefronts       │ brand_id                │ brands                       │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ storefronts       │ profile_id              │ amz_ad_profiles              │ ∞ : 1 │\n  ├───────────────────┼─────────────────────────┼──────────────────────────────┼───────┤\n  │ products          │ amz_brand_name (string) │ derives ABSTRACT (not an FK) │ —     │\n  └───────────────────┴─────────────────────────┴──────────────────────────────┴───────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
