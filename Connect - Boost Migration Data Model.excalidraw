    {
      "id": "DqzoJhvNbeC25WrUfCN1z",
      "type": "text",
      "x": -6157.2342756695225,
      "y": 1014.2705184727837,
      "width": 973.4786376953125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
