      "isDeleted": false,
      "boundElements": [],
      "updated": 1783031595026,
      "link": null,
      "locked": false,
      "text": "At Onboarding, \n1. Parent brand is created\n2. Abstract brands + profile brands are created later on\n3. amz_ad_profiles.brand_id points at parent\n4. ",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At Onboarding, \n1. Parent brand is created\n2. Abstract brands + profile brands are created later on\n3. amz_ad_profiles.brand_id points at parent\n4. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
