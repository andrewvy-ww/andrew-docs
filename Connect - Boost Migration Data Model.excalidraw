      "boundElements": [],
      "updated": 1788289062664,
      "link": null,
      "locked": false,
      "text": "Boost account\n1. One meta ad account\nOne facebook page, one ig account\n\nEntity that can run ads\n\naccount\n- brand-name is populated -> brand\n\n\naccount.brand_name is like an abstract brand in Connect",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Boost account\n1. One meta ad account\nOne facebook page, one ig account\n\nEntity that can run ads\n\naccount\n- brand-name is populated -> brand\n\n\naccount.brand_name is like an abstract brand in Connect",
      "autoResize": true,
      "lineHeight": 1.25
