    {
      "id": "Zc-A4carQeA6HhABIW4uy",
      "type": "text",
      "x": -3480.8172056209823,
      "y": 1634.7855330008385,
      "width": 1730.43994140625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
