    },
    {
      "id": "1qNZgWRodqJrW1UNtp0hZ",
      "type": "text",
      "x": -747.9652749105833,
      "y": 1286.1694105324698,
      "width": 1736.53076171875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 863150460,
      "version": 529,
      "versionNonce": 1676292348,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783028242105,
      "link": null,
      "locked": false,
      "text": "Why does connect split abstract brand and profile brand?\n- One Amazon seller account (\"Home Goods\") sells products under many brand names (West Elm, Wayfair, ...)\nso a single sync produced many abstract brands. Connect \"auto-derives\" from the amz_brand_name string across multiple seller accounts\n\n\nIn Boost seller_account = profile brand, account = abstract brand\n\nCo",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why does connect split abstract brand and profile brand?\n- One Amazon seller account (\"Home Goods\") sells products under many brand names (West Elm, Wayfair, ...)\nso a single sync produced many abstract brands. Connect \"auto-derives\" from the amz_brand_name string across multiple seller accounts\n\n\nIn Boost seller_account = profile brand, account = abstract brand\n\nCo",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lYcxx2BhK8kYh0SqvBQJ7",
      "type": "text",
      "x": -4405.43698421894,
      "y": 20.82663256562205,
      "width": 252.16786193847656,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1086220484,
      "version": 20,
      "versionNonce": 1938777924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783028437217,
      "link": null,
      "locked": false,
