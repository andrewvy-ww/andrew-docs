      "isDeleted": false,
      "boundElements": [],
      "updated": 1783028695631,
      "link": null,
      "locked": false,
      "text": "Brand is just a `brand` string on a product returned from\nAmazon, there is no login for a brand",
      "fontSize": 26.096243301932287,
      "fontFamily": 6,
