    {
      "id": "waLX9cDYKafDa5hbvGonM",
      "type": "text",
      "x": 518.485107421875,
      "y": 87.652587890625,
      "width": 171.09982299804688,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
